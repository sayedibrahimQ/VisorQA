  <diagram name="3. Database Schema (PostgreSQL ERD)" id="visorqa_db_page">
    <mxGraphModel dx="2200" dy="1400" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2200" pageHeight="1300" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title_banner_db" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#0F172A;strokeColor=#FBBF24;strokeWidth=1.5;fontColor=#F8FAFC;align=center;shadow=1;" value="&lt;b&gt;&lt;font color=&quot;#fbbf24&quot; style=&quot;font-size: 18px;&quot;&gt;🛡️ VisorQA — PostgreSQL 16 Enterprise Relational Schema &amp; Storage Architecture&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#94a3b8&quot; style=&quot;font-size: 12px;&quot;&gt;Async SQLModel / SQLAlchemy ORM • JSONB Native Documents • GIN &amp; Covering Composite Indexes • Database-Level CHECK Constraints&lt;/font&gt;" vertex="1">
          <mxGeometry x="40" y="20" width="2100" height="60" as="geometry" />
        </mxCell>
        <mxCell id="table_repo" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#111827;strokeColor=#38BDF8;strokeWidth=1.5;fontColor=#F8FAFC;align=left;spacingLeft=14;fontSize=11;shadow=1;" value="&lt;b&gt;&lt;font color=&quot;#38bdf8&quot; style=&quot;font-size:14px;&quot;&gt;repositories&lt;/font&gt;&lt;/b&gt; &amp;nbsp;&lt;font color=&quot;#94a3b8&quot; style=&quot;font-size:11px;&quot;&gt;«table (PostgreSQL 16)»&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#64748b&quot;&gt;────────────────────────────────────────────&lt;/font&gt;&lt;br&gt;&lt;b&gt;&lt;font color=&quot;#fbbf24&quot;&gt;PK&lt;/font&gt; id&lt;/b&gt;: VARCHAR / UUID &amp;nbsp;&amp;nbsp;&lt;font color=&quot;#94a3b8&quot;&gt;NOT NULL&lt;/font&gt;&lt;br&gt;&lt;b&gt;&lt;font color=&quot;#38bdf8&quot;&gt;UQ&lt;/font&gt; repo_full_name&lt;/b&gt;: VARCHAR(255) &amp;nbsp;&amp;nbsp;&lt;font color=&quot;#38bdf8&quot;&gt;INDEX&lt;/font&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;b&gt;default_branch&lt;/b&gt;: VARCHAR(64) &amp;nbsp;&amp;nbsp;&lt;font color=&quot;#94a3b8&quot;&gt;DEFAULT 'main'&lt;/font&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;b&gt;protected_globs&lt;/b&gt;: JSONB &amp;nbsp;&amp;nbsp;&lt;font color=&quot;#94a3b8&quot;&gt;DEFAULT '[&quot;src/components/ui/*&quot;]'&lt;/font&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;b&gt;modal_snapshot_id&lt;/b&gt;: VARCHAR(255) &amp;nbsp;&amp;nbsp;&lt;font color=&quot;#64748b&quot;&gt;NULLABLE&lt;/font&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;b&gt;commit_mode&lt;/b&gt;: VARCHAR(32) &amp;nbsp;&amp;nbsp;&lt;font color=&quot;#94a3b8&quot;&gt;DEFAULT 'SUGGEST_REVIEW'&lt;/font&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;b&gt;is_active&lt;/b&gt;: BOOLEAN &amp;nbsp;&amp;nbsp;&lt;font color=&quot;#94a3b8&quot;&gt;DEFAULT TRUE&lt;/font&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;b&gt;created_at&lt;/b&gt;: TIMESTAMPTZ &amp;nbsp;&amp;nbsp;&lt;font color=&quot;#94a3b8&quot;&gt;DEFAULT NOW()&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#64748b&quot;&gt;────────────────────────────────────────────&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#94a3b8&quot; style=&quot;font-size:10px;&quot;&gt;&lt;b&gt;INDEXES:&lt;/b&gt; uq_repo_full_name, idx_repos_active&lt;/font&gt;" vertex="1">
          <mxGeometry x="40" y="100" width="440" height="240" as="geometry" />
        </mxCell>
        <mxCell id="table_watched" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#111827;strokeColor=#F59E0B;strokeWidth=1.5;fontColor=#F8FAFC;align=left;spacingLeft=14;fontSize=11;shadow=1;" value="&lt;b&gt;&lt;font color=&quot;#f59e0b&quot; style=&quot;font-size:14px;&quot;&gt;watched_repository&lt;/font&gt;&lt;/b&gt; &amp;nbsp;&lt;font color=&quot;#94a3b8&quot; style=&quot;font-size:11px;&quot;&gt;«singleton row (id=1)»&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#64748b&quot;&gt;────────────────────────────────────────────&lt;/font&gt;&lt;br&gt;&lt;b&gt;&lt;font color=&quot;#fbbf24&quot;&gt;PK&lt;/font&gt; id&lt;/b&gt;: INT &amp;nbsp;&amp;nbsp;&lt;font color=&quot;#f59e0b&quot;&gt;CHECK (id = 1)&lt;/font&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;b&gt;repo_full_name&lt;/b&gt;: VARCHAR(255) &amp;nbsp;&amp;nbsp;&lt;font color=&quot;#38bdf8&quot;&gt;INDEX&lt;/font&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;b&gt;default_branch&lt;/b&gt;: VARCHAR(64) &amp;nbsp;&amp;nbsp;&lt;font color=&quot;#94a3b8&quot;&gt;DEFAULT 'main'&lt;/font&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;b&gt;installation_id&lt;/b&gt;: BIGINT &amp;nbsp;&amp;nbsp;&lt;font color=&quot;#64748b&quot;&gt;NULLABLE (GitHub App ID)&lt;/font&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;b&gt;webhook_active&lt;/b&gt;: BOOLEAN &amp;nbsp;&amp;nbsp;&lt;font color=&quot;#94a3b8&quot;&gt;DEFAULT FALSE&lt;/font&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;b&gt;auto_heal_enabled&lt;/b&gt;: BOOLEAN &amp;nbsp;&amp;nbsp;&lt;font color=&quot;#94a3b8&quot;&gt;DEFAULT TRUE&lt;/font&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;b&gt;updated_at&lt;/b&gt;: TIMESTAMPTZ &amp;nbsp;&amp;nbsp;&lt;font color=&quot;#94a3b8&quot;&gt;DEFAULT NOW()&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#64748b&quot;&gt;────────────────────────────────────────────&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#f59e0b&quot; style=&quot;font-size:10px;&quot;&gt;&lt;b&gt;FALLBACK:&lt;/b&gt; Synced to artifacts/watched_repo.json when offline&lt;/font&gt;" vertex="1">
          <mxGeometry x="40" y="370" width="440" height="230" as="geometry" />
        </mxCell>
        <mxCell id="table_runs" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#111827;strokeColor=#818CF8;strokeWidth=1.5;fontColor=#F8FAFC;align=left;spacingLeft=14;fontSize=11;shadow=1;" value="&lt;b&gt;&lt;font color=&quot;#818cf8&quot; style=&quot;font-size:14px;&quot;&gt;pr_runs&lt;/font&gt;&lt;/b&gt; &amp;nbsp;&lt;font color=&quot;#94a3b8&quot; style=&quot;font-size:11px;&quot;&gt;«master FSM aggregate root»&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#64748b&quot;&gt;──────────────────────────────────────────────────────────&lt;/font&gt;&lt;br&gt;&lt;b&gt;&lt;font color=&quot;#fbbf24&quot;&gt;PK&lt;/font&gt; id&lt;/b&gt;: VARCHAR / UUID &amp;nbsp;&amp;nbsp;&lt;font color=&quot;#94a3b8&quot;&gt;NOT NULL&lt;/font&gt;&lt;br&gt;&lt;b&gt;&lt;font color=&quot;#a78bfa&quot;&gt;FK&lt;/font&gt; repo_id&lt;/b&gt;: VARCHAR / UUID &amp;nbsp;&amp;nbsp;&lt;font color=&quot;#a78bfa&quot;&gt;REFERENCES repositories(id) INDEX&lt;/font&gt;&lt;br&gt;&lt;b&gt;&lt;font color=&quot;#38bdf8&quot;&gt;UQ&lt;/font&gt; github_delivery_id&lt;/b&gt;: VARCHAR(64) &amp;nbsp;&amp;nbsp;&lt;font color=&quot;#38bdf8&quot;&gt;UNIQUE&lt;/font&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;b&gt;repo_full_name&lt;/b&gt;: VARCHAR(255) &amp;nbsp;&amp;nbsp;&lt;font color=&quot;#38bdf8&quot;&gt;INDEX&lt;/font&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;b&gt;pr_number&lt;/b&gt;: INT &amp;nbsp;&amp;nbsp;&lt;font color=&quot;#38bdf8&quot;&gt;INDEX&lt;/font&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;b&gt;pr_title&lt;/b&gt;: VARCHAR(512) &amp;nbsp;&amp;nbsp;&lt;font color=&quot;#64748b&quot;&gt;NULLABLE&lt;/font&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;b&gt;branch&lt;/b&gt;: VARCHAR(128) &amp;nbsp;&amp;nbsp;&lt;font color=&quot;#94a3b8&quot;&gt;DEFAULT 'main'&lt;/font&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;b&gt;commit_sha&lt;/b&gt;: VARCHAR(64) &amp;nbsp;&amp;nbsp;&lt;font color=&quot;#38bdf8&quot;&gt;INDEX&lt;/font&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;b&gt;status&lt;/b&gt;: VARCHAR(32) &amp;nbsp;&amp;nbsp;&lt;font color=&quot;#38bdf8&quot;&gt;INDEX (QUEUED..RESOLVED..FAILED)&lt;/font&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;b&gt;attempt&lt;/b&gt;: INT &amp;nbsp;&amp;nbsp;&lt;font color=&quot;#f59e0b&quot;&gt;CHECK (attempt BETWEEN 0 AND 3)&lt;/font&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;b&gt;max_attempts&lt;/b&gt;: INT &amp;nbsp;&amp;nbsp;&lt;font color=&quot;#94a3b8&quot;&gt;DEFAULT 3&lt;/font&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;b&gt;target_files&lt;/b&gt;: JSONB &amp;nbsp;&amp;nbsp;&lt;font color=&quot;#94a3b8&quot;&gt;DEFAULT '[]'&lt;/font&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;b&gt;initial_score&lt;/b&gt;: FLOAT &amp;nbsp;&amp;nbsp;&lt;font color=&quot;#94a3b8&quot;&gt;DEFAULT 0.0&lt;/font&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;b&gt;best_score&lt;/b&gt;: FLOAT &amp;nbsp;&amp;nbsp;&lt;font color=&quot;#94a3b8&quot;&gt;DEFAULT 0.0&lt;/font&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;b&gt;best_patch&lt;/b&gt;: TEXT &amp;nbsp;&amp;nbsp;&lt;font color=&quot;#64748b&quot;&gt;NULLABLE (Preserved for review)&lt;/font&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;b&gt;is_resolved&lt;/b&gt;: BOOLEAN &amp;nbsp;&amp;nbsp;&lt;font color=&quot;#38bdf8&quot;&gt;INDEX DEFAULT FALSE&lt;/font&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;b&gt;healed_commit_sha&lt;/b&gt;: VARCHAR(64) &amp;nbsp;&amp;nbsp;&lt;font color=&quot;#64748b&quot;&gt;NULLABLE&lt;/font&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;b&gt;total_latency_ms&lt;/b&gt;: INT &amp;nbsp;&amp;nbsp;&lt;font color=&quot;#94a3b8&quot;&gt;DEFAULT 0&lt;/font&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;b&gt;total_cost_usd&lt;/b&gt;: NUMERIC(6,4) &amp;nbsp;&amp;nbsp;&lt;font color=&quot;#f87171&quot;&gt;CHECK (total_cost_usd &lt;= 0.15)&lt;/font&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;b&gt;created_at / updated_at&lt;/b&gt;: TIMESTAMPTZ &amp;nbsp;&amp;nbsp;&lt;font color=&quot;#94a3b8&quot;&gt;DEFAULT NOW()&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#64748b&quot;&gt;──────────────────────────────────────────────────────────&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#94a3b8&quot; style=&quot;font-size:10px;&quot;&gt;&lt;b&gt;CONSTRAINTS:&lt;/b&gt; chk_pr_runs_3_strike_cap, chk_pr_runs_cost_guardrail&lt;br&gt;&lt;b&gt;COVERING INDEX:&lt;/b&gt; idx_pr_runs_dashboard_covering (repo_full_name, created_at DESC)&lt;/font&gt;" vertex="1">
          <mxGeometry x="520" y="100" width="530" height="540" as="geometry" />
        </mxCell>
        <mxCell id="table_anom" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#111827;strokeColor=#F43F5E;strokeWidth=1.5;fontColor=#F8FAFC;align=left;spacingLeft=14;fontSize=11;shadow=1;" value="&lt;b&gt;&lt;font color=&quot;#f43f5e&quot; style=&quot;font-size:14px;&quot;&gt;visual_anomalies&lt;/font&gt;&lt;/b&gt; &amp;nbsp;&lt;font color=&quot;#94a3b8&quot; style=&quot;font-size:11px;&quot;&gt;«optical discrepancy records»&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#64748b&quot;&gt;──────────────────────────────────────────────────────────&lt;/font&gt;&lt;br&gt;&lt;b&gt;&lt;font color=&quot;#fbbf24&quot;&gt;PK&lt;/font&gt; id&lt;/b&gt;: VARCHAR / UUID &amp;nbsp;&amp;nbsp;&lt;font color=&quot;#94a3b8&quot;&gt;NOT NULL&lt;/font&gt;&lt;br&gt;&lt;b&gt;&lt;font color=&quot;#a78bfa&quot;&gt;FK&lt;/font&gt; run_id&lt;/b&gt;: VARCHAR / UUID &amp;nbsp;&amp;nbsp;&lt;font color=&quot;#f87171&quot;&gt;REFERENCES pr_runs(id) ON DELETE CASCADE INDEX&lt;/font&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;b&gt;attempt_num&lt;/b&gt;: INT &amp;nbsp;&amp;nbsp;&lt;font color=&quot;#38bdf8&quot;&gt;INDEX DEFAULT 0&lt;/font&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;b&gt;viewport&lt;/b&gt;: VARCHAR(16) &amp;nbsp;&amp;nbsp;&lt;font color=&quot;#f87171&quot;&gt;CHECK (viewport IN ('375px', '1440px')) INDEX&lt;/font&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;b&gt;visor_el_id&lt;/b&gt;: VARCHAR(64) &amp;nbsp;&amp;nbsp;&lt;font color=&quot;#38bdf8&quot;&gt;INDEX (1:1 DOM-to-SAM ID)&lt;/font&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;b&gt;secondary_el_id&lt;/b&gt;: VARCHAR(64) &amp;nbsp;&amp;nbsp;&lt;font color=&quot;#64748b&quot;&gt;NULLABLE (Collision Partner)&lt;/font&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;b&gt;defect_type&lt;/b&gt;: VARCHAR(32) &amp;nbsp;&amp;nbsp;&lt;font color=&quot;#38bdf8&quot;&gt;INDEX (OCCLUSION | COLLISION | BLEED)&lt;/font&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;b&gt;v_r&lt;/b&gt;: FLOAT &amp;nbsp;&amp;nbsp;&lt;font color=&quot;#38bdf8&quot;&gt;NULLABLE (Area(M_SAM) / Area(B_DOM))&lt;/font&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;b&gt;iou&lt;/b&gt;: FLOAT &amp;nbsp;&amp;nbsp;&lt;font color=&quot;#f87171&quot;&gt;NULLABLE (Area(Mi ∩ Mj) / Area(Mi ∪ Mj))&lt;/font&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;b&gt;bleed_px&lt;/b&gt;: FLOAT &amp;nbsp;&amp;nbsp;&lt;font color=&quot;#f59e0b&quot;&gt;NULLABLE (max(0, Xmax - Wvp))&lt;/font&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;b&gt;b_dom_box&lt;/b&gt;: JSONB &amp;nbsp;&amp;nbsp;&lt;font color=&quot;#94a3b8&quot;&gt;NOT NULL {x, y, width, height, selector}&lt;/font&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;b&gt;lca_dom&lt;/b&gt;: JSONB &amp;nbsp;&amp;nbsp;&lt;font color=&quot;#c084fc&quot;&gt;NOT NULL (DOM Ancestor Subtree) GIN INDEX&lt;/font&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;b&gt;mask_url&lt;/b&gt;: TEXT &amp;nbsp;&amp;nbsp;&lt;font color=&quot;#64748b&quot;&gt;NULLABLE (Artifact Disk Path)&lt;/font&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;b&gt;is_resolved&lt;/b&gt;: BOOLEAN &amp;nbsp;&amp;nbsp;&lt;font color=&quot;#38bdf8&quot;&gt;INDEX DEFAULT FALSE&lt;/font&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;b&gt;created_at&lt;/b&gt;: TIMESTAMPTZ &amp;nbsp;&amp;nbsp;&lt;font color=&quot;#94a3b8&quot;&gt;DEFAULT NOW()&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#64748b&quot;&gt;──────────────────────────────────────────────────────────&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#f43f5e&quot; style=&quot;font-size:10px;&quot;&gt;&lt;b&gt;CHECK:&lt;/b&gt; (type='OCCLUSION' AND Vr&lt;0.85) OR (type='COLLISION' AND IoU&gt;0.05) OR (type='BLEED' AND bleed&gt;2px)&lt;br&gt;&lt;b&gt;GIN INDEX:&lt;/b&gt; idx_anomalies_lca_gin ON lca_dom USING gin&lt;/font&gt;" vertex="1">
          <mxGeometry x="1090" y="100" width="550" height="470" as="geometry" />
        </mxCell>
        <mxCell id="table_att" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#111827;strokeColor=#34D399;strokeWidth=1.5;fontColor=#F8FAFC;align=left;spacingLeft=14;fontSize=11;shadow=1;" value="&lt;b&gt;&lt;font color=&quot;#34d399&quot; style=&quot;font-size:14px;&quot;&gt;repair_attempts&lt;/font&gt;&lt;/b&gt; &amp;nbsp;&lt;font color=&quot;#94a3b8&quot; style=&quot;font-size:11px;&quot;&gt;«3-strike closed-loop audit trail»&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#64748b&quot;&gt;──────────────────────────────────────────────────────────&lt;/font&gt;&lt;br&gt;&lt;b&gt;&lt;font color=&quot;#fbbf24&quot;&gt;PK&lt;/font&gt; id&lt;/b&gt;: VARCHAR / UUID &amp;nbsp;&amp;nbsp;&lt;font color=&quot;#94a3b8&quot;&gt;NOT NULL&lt;/font&gt;&lt;br&gt;&lt;b&gt;&lt;font color=&quot;#a78bfa&quot;&gt;FK&lt;/font&gt; run_id&lt;/b&gt;: VARCHAR / UUID &amp;nbsp;&amp;nbsp;&lt;font color=&quot;#f87171&quot;&gt;REFERENCES pr_runs(id) ON DELETE CASCADE INDEX&lt;/font&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;b&gt;attempt_number&lt;/b&gt;: INT &amp;nbsp;&amp;nbsp;&lt;font color=&quot;#f59e0b&quot;&gt;CHECK (attempt_number BETWEEN 1 AND 3)&lt;/font&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;b&gt;repair_spec&lt;/b&gt;: JSONB &amp;nbsp;&amp;nbsp;&lt;font color=&quot;#c084fc&quot;&gt;NOT NULL (Muse Wonder Spec) GIN INDEX&lt;/font&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;b&gt;unified_diff&lt;/b&gt;: TEXT &amp;nbsp;&amp;nbsp;&lt;font color=&quot;#a855f7&quot;&gt;NULLABLE (Muse Code Patch Hunks)&lt;/font&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;b&gt;telemetry&lt;/b&gt;: JSONB &amp;nbsp;&amp;nbsp;&lt;font color=&quot;#94a3b8&quot;&gt;NOT NULL (Dual-Viewport Metrics Snapshot)&lt;/font&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;b&gt;mobile_v_r_min&lt;/b&gt;: FLOAT &amp;nbsp;&amp;nbsp;&lt;font color=&quot;#94a3b8&quot;&gt;DEFAULT 0.0 (375px lowest Vr)&lt;/font&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;b&gt;desktop_v_r_min&lt;/b&gt;: FLOAT &amp;nbsp;&amp;nbsp;&lt;font color=&quot;#94a3b8&quot;&gt;DEFAULT 1.0 (1440px lowest Vr)&lt;/font&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;b&gt;verified_iou&lt;/b&gt;: FLOAT &amp;nbsp;&amp;nbsp;&lt;font color=&quot;#94a3b8&quot;&gt;DEFAULT 0.0&lt;/font&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;b&gt;verified_bleed_px&lt;/b&gt;: FLOAT &amp;nbsp;&amp;nbsp;&lt;font color=&quot;#94a3b8&quot;&gt;DEFAULT 0.0&lt;/font&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;b&gt;post_score&lt;/b&gt;: FLOAT &amp;nbsp;&amp;nbsp;&lt;font color=&quot;#34d399&quot;&gt;DEFAULT 0.0 (Health H)&lt;/font&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;b&gt;hmr_latency_ms&lt;/b&gt;: INT &amp;nbsp;&amp;nbsp;&lt;font color=&quot;#94a3b8&quot;&gt;DEFAULT 0&lt;/font&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;b&gt;passed&lt;/b&gt;: BOOLEAN &amp;nbsp;&amp;nbsp;&lt;font color=&quot;#34d399&quot;&gt;DEFAULT FALSE (H &gt;= 0.98 on both VPs)&lt;/font&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;b&gt;error_message&lt;/b&gt;: TEXT &amp;nbsp;&amp;nbsp;&lt;font color=&quot;#64748b&quot;&gt;NULLABLE&lt;/font&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;b&gt;created_at&lt;/b&gt;: TIMESTAMPTZ &amp;nbsp;&amp;nbsp;&lt;font color=&quot;#94a3b8&quot;&gt;DEFAULT NOW()&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#64748b&quot;&gt;──────────────────────────────────────────────────────────&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#34d399&quot; style=&quot;font-size:10px;&quot;&gt;&lt;b&gt;ANTI-HACK CHECK:&lt;/b&gt; diff NOT ILIKE '%!important%' AND NOT ILIKE '%z-index: 9999%'&lt;br&gt;&lt;b&gt;UNIQUE:&lt;/b&gt; uq_run_attempt_number (run_id, attempt_number)&amp;nbsp;&amp;nbsp;|&amp;nbsp;&amp;nbsp;&lt;b&gt;GIN:&lt;/b&gt; idx_attempts_repair_spec_gin&lt;/font&gt;" vertex="1">
          <mxGeometry x="1090" y="600" width="550" height="480" as="geometry" />
        </mxCell>
        <mxCell id="card_guardrails" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#1E293B;strokeColor=#FBBF24;strokeWidth=1.5;fontColor=#F8FAFC;align=left;spacingLeft=12;fontSize=11;shadow=1;" value="&lt;b&gt;&lt;font color=&quot;#fbbf24&quot; style=&quot;font-size:13px;&quot;&gt;Database Guardrails &amp; Constraints&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;• &lt;b&gt;BR-1 (Single-Repo Sentinel):&lt;/b&gt;&lt;br&gt;  watched_repository enforces singleton row (id=1). VisorQA operates with strict laser focus.&lt;br&gt;&lt;br&gt;• &lt;b&gt;BR-2 (3-Strike Cap):&lt;/b&gt;&lt;br&gt;  CHECK (attempt BETWEEN 0 AND 3). Prevents runaway loops or unbounded inference costs.&lt;br&gt;&lt;br&gt;• &lt;b&gt;BR-3 (Cost Guardrail):&lt;/b&gt;&lt;br&gt;  CHECK (total_cost_usd &lt;= 0.15). Any run over 15¢ halts to protect project budget.&lt;br&gt;&lt;br&gt;• &lt;b&gt;BR-4 (Anti-Hack CSS Check):&lt;/b&gt;&lt;br&gt;  Rejects !important and z-index 9999 at the database constraint level.&lt;br&gt;&lt;br&gt;• &lt;b&gt;BR-5 (Cascade Cleanup):&lt;/b&gt;&lt;br&gt;  Deleting a run cascades ON DELETE CASCADE on all anomalies and attempts." vertex="1">
          <mxGeometry x="1680" y="100" width="460" height="320" as="geometry" />
        </mxCell>
        <mxCell id="card_jsonb" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#1E293B;strokeColor=#38BDF8;strokeWidth=1.5;fontColor=#F8FAFC;align=left;spacingLeft=12;fontSize=10;fontFamily=monospace;shadow=1;" value="&lt;b&gt;&lt;font color=&quot;#38bdf8&quot; style=&quot;font-size:13px;&quot;&gt;JSONB Document Structures &amp; GIN Indexes&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;visual_anomalies.b_dom_box:&lt;/b&gt;&lt;br&gt;{&quot;x&quot;: 24.0, &quot;y&quot;: 112.5, &quot;width&quot;: 327.0, &quot;height&quot;: 48.0, &quot;selector&quot;: &quot;button#cta&quot;}&lt;br&gt;&lt;br&gt;&lt;b&gt;repair_attempts.repair_spec (GIN INDEXED):&lt;/b&gt;&lt;br&gt;{&quot;root_cause&quot;: &quot;Sticky banner overlaps CTA at 375px&quot;,&lt;br&gt; &quot;target_file&quot;: &quot;src/pages/Checkout.tsx&quot;,&lt;br&gt; &quot;strategy&quot;: &quot;Change banner to relative on mobile&quot;,&lt;br&gt; &quot;tailwind_classes_to_add&quot;: [&quot;relative&quot;, &quot;md:sticky&quot;]}&lt;br&gt;&lt;br&gt;&lt;b&gt;repair_attempts.telemetry:&lt;/b&gt;&lt;br&gt;{&quot;mobile&quot;: {&quot;v_r&quot;: 1.0, &quot;iou&quot;: 0.0, &quot;bleed_px&quot;: 0.0},&lt;br&gt; &quot;desktop&quot;: {&quot;v_r&quot;: 1.0, &quot;iou&quot;: 0.0, &quot;bleed_px&quot;: 0.0},&lt;br&gt; &quot;composite_health&quot;: 1.0, &quot;passed&quot;: true}" vertex="1">
          <mxGeometry x="1680" y="450" width="460" height="310" as="geometry" />
        </mxCell>
        <mxCell id="card_perf" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#1E293B;strokeColor=#34D399;strokeWidth=1.5;fontColor=#F8FAFC;align=left;spacingLeft=12;fontSize=11;shadow=1;" value="&lt;b&gt;&lt;font color=&quot;#34d399&quot; style=&quot;font-size:13px;&quot;&gt;PostgreSQL Performance Strategy&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;• &lt;b&gt;Covering Index:&lt;/b&gt; idx_pr_runs_dashboard_covering serves dashboard queries in &lt; 1.5ms without heap visits.&lt;br&gt;&lt;br&gt;• &lt;b&gt;Inverted GIN Indexes:&lt;/b&gt; Sub-millisecond JSON query path lookups on lca_dom and repair_spec.&lt;br&gt;&lt;br&gt;• &lt;b&gt;Asyncpg Pool:&lt;/b&gt; 10 persistent connections with 20 max overflow for non-blocking coroutines." vertex="1">
          <mxGeometry x="1680" y="790" width="460" height="220" as="geometry" />
        </mxCell>
