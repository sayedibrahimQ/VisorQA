        <mxCell id="card_rest" parent="lane_gateway" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#1E293B;strokeColor=#475569;strokeWidth=1;fontColor=#F8FAFC;align=left;spacingLeft=12;fontSize=11;shadow=1;" value="&lt;b&gt;&lt;font color=&quot;#cbd5e1&quot; style=&quot;font-size:13px;&quot;&gt;REST Control Endpoints&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#94a3b8&quot; style=&quot;font-size:11px;&quot;&gt;backend/api/github_repos.py &amp; main.py&lt;/font&gt;&lt;br&gt;&lt;br&gt;• &lt;b&gt;GET/PUT /api/github/repositories/watched&lt;/b&gt;&lt;br&gt;• &lt;b&gt;GET /api/runs:&lt;/b&gt; Paginated run list&lt;br&gt;• &lt;b&gt;GET /api/runs/{id}:&lt;/b&gt; Full run audit trail&lt;br&gt;• &lt;b&gt;POST /api/runs/{id}/retry:&lt;/b&gt; Manual retry" vertex="1">
