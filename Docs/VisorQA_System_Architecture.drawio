        <mxCell id="lane_fsm" parent="1" style="swimlane;whiteSpace=wrap;html=1;fillColor=#1E1B4B;strokeColor=#818CF8;fontColor=#A5B4FC;startSize=40;rounded=1;arcSize=6;fontStyle=1;fontSize=12;shadow=1;collapsible=0;" value="&lt;b&gt;3. 5-NODE DETERMINISTIC FSM &amp; MATH ENGINE&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#a5b4fc&quot; style=&quot;font-size:11px;&quot;&gt;backend/core/orchestrator.py &amp; vision_math.py&lt;/font&gt;" vertex="1">
          <mxGeometry x="760" y="100" width="470" height="1000" as="geometry" />
        </mxCell>
        <mxCell id="card_orch_hdr" parent="lane_fsm" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#312E81;strokeColor=#818CF8;strokeWidth=2;fontColor=#FFFFFF;align=center;fontSize=11;shadow=1;" value="&lt;b&gt;&lt;font color=&quot;#ffffff&quot; style=&quot;font-size:14px;&quot;&gt;VisorOrchestrator (Deterministic FSM)&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#c7d2fe&quot; style=&quot;font-size:11px;&quot;&gt;Controls state transitions: QUEUED → SENSE → TRIAGE → DIAGNOSE → PATCH → VERIFY&lt;/font&gt;" vertex="1">
          <mxGeometry x="20" y="55" width="430" height="55" as="geometry" />
        </mxCell>
        <mxCell id="node_sense" parent="lane_fsm" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#1E293B;strokeColor=#38BDF8;strokeWidth=1.5;fontColor=#F8FAFC;align=left;spacingLeft=10;fontSize=11;" value="&lt;b&gt;&lt;font color=&quot;#38bdf8&quot;&gt;[NODE 01] SENSE&lt;/font&gt;&lt;/b&gt; — &lt;i&gt;backend/core/sense.py&lt;/i&gt;&lt;br&gt;• Dual-viewport Playwright: Mobile (375×812) &amp; Desktop (1440×900)&lt;br&gt;• Extracts &lt;b&gt;visor-el-id&lt;/b&gt; tags &amp; bounding boxes (B_DOM)&lt;br&gt;• Meta SAM 3.1 zero-shot segmentation → Binary masks (M_SAM)&lt;br&gt;• Initial anomaly detection: Occlusion, Collision, Bleed" vertex="1">
          <mxGeometry x="20" y="120" width="430" height="90" as="geometry" />
        </mxCell>
        <mxCell id="node_triage" parent="lane_fsm" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#1E293B;strokeColor=#F59E0B;strokeWidth=1.5;fontColor=#F8FAFC;align=left;spacingLeft=10;fontSize=11;" value="&lt;b&gt;&lt;font color=&quot;#f59e0b&quot;&gt;[NODE 02] TRIAGE&lt;/font&gt;&lt;/b&gt; — &lt;i&gt;backend/core/triage.py&lt;/i&gt;&lt;br&gt;• Computes Lowest Common Ancestor (LCA) DOM subtree&lt;br&gt;• Meta Muse Spark 1.3 isolates target layout file (88.5% token prune)&lt;br&gt;• &lt;b&gt;Component Shielding:&lt;/b&gt; Locks &lt;i&gt;src/components/ui/*&lt;/i&gt; from edits&lt;br&gt;• Deterministic single-run execution per PR" vertex="1">
          <mxGeometry x="20" y="225" width="430" height="90" as="geometry" />
        </mxCell>
        <mxCell id="node_diagnose" parent="lane_fsm" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#1E293B;strokeColor=#C084FC;strokeWidth=1.5;fontColor=#F8FAFC;align=left;spacingLeft=10;fontSize=11;" value="&lt;b&gt;&lt;font color=&quot;#c084fc&quot;&gt;[NODE 03] DIAGNOSE&lt;/font&gt;&lt;/b&gt; — &lt;i&gt;backend/core/diagnose.py&lt;/i&gt;&lt;br&gt;• Meta Muse Wonder 1.0 (Multimodal Optical Architect)&lt;br&gt;• Analyzes red collision-mask overlay image + CSS hierarchy&lt;br&gt;• Produces structured &lt;b&gt;RepairSpec (Pydantic JSON)&lt;/b&gt;&lt;br&gt;• &lt;b&gt;Zero Code Policy:&lt;/b&gt; Pure architectural diagnostic blueprint" vertex="1">
          <mxGeometry x="20" y="330" width="430" height="90" as="geometry" />
        </mxCell>
        <mxCell id="node_patch" parent="lane_fsm" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#1E293B;strokeColor=#A855F7;strokeWidth=1.5;fontColor=#F8FAFC;align=left;spacingLeft=10;fontSize=11;" value="&lt;b&gt;&lt;font color=&quot;#a855f7&quot;&gt;[NODE 04] PATCH&lt;/font&gt;&lt;/b&gt; — &lt;i&gt;backend/core/patch.py&lt;/i&gt;&lt;br&gt;• Meta Muse Code 1.3 (Surgical Unified Diff Patcher)&lt;br&gt;• Ingests RepairSpec + isolated target file source code&lt;br&gt;• &lt;b&gt;Anti-Hack CSS Gate:&lt;/b&gt; Rejects !important, z-9999, negative margins&lt;br&gt;• Enforces standard Tailwind responsive breakpoints (md:, lg:)" vertex="1">
          <mxGeometry x="20" y="435" width="430" height="90" as="geometry" />
        </mxCell>
        <mxCell id="node_verify" parent="lane_fsm" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#1E293B;strokeColor=#34D399;strokeWidth=1.5;fontColor=#F8FAFC;align=left;spacingLeft=10;fontSize=11;" value="&lt;b&gt;&lt;font color=&quot;#34d399&quot;&gt;[NODE 05] VERIFY&lt;/font&gt;&lt;/b&gt; — &lt;i&gt;backend/core/verify.py&lt;/i&gt;&lt;br&gt;• Applies diff in isolated sandbox via Hot Module Reload (&lt; 300ms HMR)&lt;br&gt;• Re-captures BOTH Mobile (375px) AND Desktop (1440px) viewports&lt;br&gt;• Computes post-repair NumPy discrepancy metrics&lt;br&gt;• &lt;b&gt;Resolution Gate:&lt;/b&gt; Requires Health &lt;b&gt;H &gt;= 0.98 on BOTH viewports&lt;/b&gt;" vertex="1">
          <mxGeometry x="20" y="540" width="430" height="90" as="geometry" />
        </mxCell>
        <mxCell id="card_math_engine" parent="lane_fsm" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#111827;strokeColor=#38BDF8;strokeWidth=1.5;fontColor=#F8FAFC;align=left;spacingLeft=12;fontSize=11;shadow=1;" value="&lt;b&gt;&lt;font color=&quot;#38bdf8&quot; style=&quot;font-size:13px;&quot;&gt;Vectorized NumPy Math Engine (vision_math.py)&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;• &lt;b&gt;Visibility Ratio:&lt;/b&gt; Vr = Area(M_SAM ∩ B_DOM) / Area(B_DOM)  [Fail if &lt; 0.85]&lt;br&gt;• &lt;b&gt;Sibling Collision:&lt;/b&gt; IoU = Area(B_A ∩ B_B) / Area(B_A ∪ B_B)  [Fail if &gt; 0.05]&lt;br&gt;• &lt;b&gt;Horizontal Bleed:&lt;/b&gt; Δx = max(0, (x + w) - W_viewport)  [Fail if &gt; 2.0px]&lt;br&gt;• &lt;b&gt;Composite Health:&lt;/b&gt; H = mean(Vr) - max(IoU) - 0.01·max(Δx)  [Pass &gt;= 0.98]" vertex="1">
          <mxGeometry x="20" y="645" width="430" height="130" as="geometry" />
        </mxCell>
        <mxCell id="card_strike_circuit" parent="lane_fsm" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#1E293B;strokeColor=#F59E0B;strokeWidth=1.5;fontColor=#F8FAFC;align=left;spacingLeft=12;fontSize=11;shadow=1;" value="&lt;b&gt;&lt;font color=&quot;#f59e0b&quot; style=&quot;font-size:13px;&quot;&gt;🔄 3-Strike Self-Healing Feedback Circuit&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;• Bounded loop: Max 3 repair attempts guardrail&lt;br&gt;• If H &lt; 0.98 &amp; attempt &lt; 3: Rollback sandbox, snapshot best patch,&lt;br&gt;  feed failure coordinates back to &lt;b&gt;Node 03 DIAGNOSE&lt;/b&gt;&lt;br&gt;• If H &gt;= 0.98: Mark &lt;b&gt;RESOLVED&lt;/b&gt; → Trigger Git Auto-Commit&lt;br&gt;• If Strike 3 Exhausted: Mark &lt;b&gt;FALLBACK&lt;/b&gt; → Post PR Review Comment" vertex="1">
          <mxGeometry x="20" y="790" width="430" height="140" as="geometry" />
        </mxCell>
        <mxCell id="lane_meta" parent="1" style="swimlane;whiteSpace=wrap;html=1;fillColor=#0F172A;strokeColor=#C084FC;fontColor=#C084FC;startSize=40;rounded=1;arcSize=6;fontStyle=1;fontSize=12;shadow=1;collapsible=0;" value="&lt;b&gt;4. META AI FOUNDATION MODELS&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#c084fc&quot; style=&quot;font-size:11px;&quot;&gt;Specialized Vision &amp; LLM Inferences&lt;/font&gt;" vertex="1">
          <mxGeometry x="1250" y="100" width="350" height="1000" as="geometry" />
        </mxCell>
        <mxCell id="card_sam" parent="lane_meta" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#1E293B;strokeColor=#38BDF8;strokeWidth=1.5;fontColor=#F8FAFC;align=left;spacingLeft=12;fontSize=11;shadow=1;" value="&lt;b&gt;&lt;font color=&quot;#38bdf8&quot; style=&quot;font-size:13px;&quot;&gt;Meta SAM 3.1 (sam-3.1)&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#94a3b8&quot; style=&quot;font-size:11px;&quot;&gt;Zero-Shot Optical Segmentation&lt;/font&gt;&lt;br&gt;&lt;br&gt;• &lt;b&gt;Input:&lt;/b&gt; Screenshot PNG + DOM centroid (cx, cy) prompt&lt;br&gt;• &lt;b&gt;Output:&lt;/b&gt; 2D binary raster mask M_SAM ∈ {0,1}&lt;sup&gt;H×W&lt;/sup&gt;&lt;br&gt;• &lt;b&gt;Inference Latency:&lt;/b&gt; ~420ms&lt;br&gt;• Senses true optical bounds independent of DOM" vertex="1">
          <mxGeometry x="20" y="60" width="310" height="150" as="geometry" />
        </mxCell>
        <mxCell id="card_spark" parent="lane_meta" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#1E293B;strokeColor=#F59E0B;strokeWidth=1.5;fontColor=#F8FAFC;align=left;spacingLeft=12;fontSize=11;shadow=1;" value="&lt;b&gt;&lt;font color=&quot;#f59e0b&quot; style=&quot;font-size:13px;&quot;&gt;Meta Muse Spark 1.3&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#94a3b8&quot; style=&quot;font-size:11px;&quot;&gt;Triage Engine (muse-spark-1.3)&lt;/font&gt;&lt;br&gt;&lt;br&gt;• &lt;b&gt;Input:&lt;/b&gt; LCA DOM Subtree + Repository Tree&lt;br&gt;• &lt;b&gt;Contract:&lt;/b&gt; response_format = SparkTriageSchema&lt;br&gt;• &lt;b&gt;Duty:&lt;/b&gt; Isolates 1-2 parent layout files&lt;br&gt;• &lt;b&gt;Shield:&lt;/b&gt; Blacklists atomic UI components&lt;br&gt;• &lt;b&gt;Speed:&lt;/b&gt; 88.5% token prune in ~580ms" vertex="1">
          <mxGeometry x="20" y="230" width="310" height="160" as="geometry" />
        </mxCell>
