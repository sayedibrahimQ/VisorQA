        <mxCell id="card_ws" parent="lane_gateway" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#1E293B;strokeColor=#6366F1;strokeWidth=1.5;fontColor=#F8FAFC;align=left;spacingLeft=12;fontSize=11;shadow=1;" value="&lt;b&gt;&lt;font color=&quot;#818cf8&quot; style=&quot;font-size:13px;&quot;&gt;Real-Time WebSocket Hub&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#94a3b8&quot; style=&quot;font-size:11px;&quot;&gt;backend/api/routes_ws.py&lt;/font&gt;&lt;br&gt;&lt;br&gt;• Observer Pattern Connection Manager&lt;br&gt;• Sub-10ms in-memory stage broadcasting&lt;br&gt;• Channels:&lt;br&gt;  - &lt;b&gt;STAGE_CHANGED:&lt;/b&gt; FSM stepper updates&lt;br&gt;  - &lt;b&gt;ANOMALY_DETECTED:&lt;/b&gt; Mask artifacts&lt;br&gt;  - &lt;b&gt;ATTEMPT_FEEDBACK:&lt;/b&gt; Diff &amp; health score" vertex="1">
