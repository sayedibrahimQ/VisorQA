          <mxGeometry x="20" y="410" width="310" height="170" as="geometry" />
        </mxCell>
        <mxCell id="card_code" parent="lane_meta" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#1E293B;strokeColor=#A855F7;strokeWidth=1.5;fontColor=#F8FAFC;align=left;spacingLeft=12;fontSize=11;shadow=1;" value="&lt;b&gt;&lt;font color=&quot;#a855f7&quot; style=&quot;font-size:13px;&quot;&gt;Meta Muse Code 1.3&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#94a3b8&quot; style=&quot;font-size:11px;&quot;&gt;Unified Diff Coder (muse-spark-1.3 code)&lt;/font&gt;&lt;br&gt;&lt;br&gt;• &lt;b&gt;Input:&lt;/b&gt; Target file source + RepairSpec JSON&lt;br&gt;• &lt;b&gt;Output:&lt;/b&gt; Verbatim Unified Diff patch hunk stream&lt;br&gt;• &lt;b&gt;Rules:&lt;/b&gt; Standard CSS flow, Tailwind breakpoint pairs&lt;br&gt;• &lt;b&gt;Performance:&lt;/b&gt; 91% first-pass resolution rate" vertex="1">
