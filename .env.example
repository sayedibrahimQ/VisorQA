# ==============================================================================
# VisorQA - Autonomous Visual QA & Self-Healing Frontend Agent
# Environment Configuration
# ==============================================================================

# --- Meta Model API Credentials (https://api.meta.ai/v1) ---
# API key for Meta models (SAM 3.1, Muse Spark, Muse Wonder, Muse Code).
# Only this key is required for Muse Spark triage and Muse Wonder
# diagnosis; the base URL and models below are the code defaults and
# may be omitted.
META_API_KEY=your_meta_model_api_key_here
# Meta Model API base URL (AsyncOpenAI base_url)
META_BASE_URL=https://api.meta.ai/v1
# SAM 3.1 segmentation endpoint path (not published in project docs;
# leave empty until the verified contract is available - never guessed)
SAM31_ENDPOINT_PATH=
# Muse Spark triage model served by the Meta Model API
MUSE_SPARK_MODEL=muse-spark-1.3
SPARK_TIMEOUT_SECONDS=15
# Muse Wonder diagnosis model served by the Meta Model API
MUSE_WONDER_MODEL=muse-wonder-1.0
WONDER_TIMEOUT_SECONDS=30
# Muse Code patch model (Muse Code is built on Muse Spark; the
# Model API serves the code role with the Spark model)
MUSE_CODE_MODEL=muse-spark-1.3
CODE_TIMEOUT_SECONDS=30
SAM31_MAX_BATCH_SIZE=40
SAM31_TIMEOUT_SECONDS=10

# --- Persistence / PostgreSQL Database ---
# PostgreSQL connection string for SQLModel (pr_runs, anomalies, attempts)
# Local Docker default: postgresql://visorqa:visorqa@localhost:5432/visorqa
# For asyncpg: postgresql+asyncpg://visorqa:visorqa@localhost:5432/visorqa
DATABASE_URL=postgresql+asyncpg://visorqa:visorqa@localhost:5432/visorqa

# --- GitHub Integration ---
# GitHub Personal Access Token (PAT) with repo & pull_request permissions for auto-commits & reviews
GITHUB_PAT=ghp_your_personal_access_token_here

# Secret used to verify HMAC SHA-256 signatures for incoming GitHub webhook events
GITHUB_WEBHOOK_SECRET=your_github_webhook_secret_here

# --- Sandbox Execution (Modal) ---
# Modal token used for launching isolated cloud container sandboxes with HMR
MODAL_TOKEN=modal_token_id_and_secret_here

# --- Server & Network Settings ---
API_HOST=0.0.0.0
API_PORT=8000
ENVIRONMENT=development
LOG_LEVEL=info

# --- Client Application URLs ---
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000

# --- Mathematical & Discrepancy Thresholds ---
# Occlusion threshold: Visibility Ratio = Area(M_SAM) / Area(B_DOM) < 0.85 indicates clipping
VISIBILITY_RATIO_THRESHOLD=0.85

# Collision threshold: IoU(M_i, M_j) > 0.05 indicates UI element overlap
IOU_COLLISION_THRESHOLD=0.05

# Self-healing maximum iterations (3-Strike Rule)
MAX_SELF_HEALING_ATTEMPTS=3
