# ==============================================================================
# VisorQA - Autonomous Visual QA & Self-Healing Frontend Agent
# Environment Configuration Template (.env.example)
# ==============================================================================

# --- Meta AI Model API Credentials (https://api.meta.ai/v1) ---
# Primary key for Meta foundation models (SAM 3.1, Muse Spark, Muse Wonder, Muse Code).
# Both META_API_KEY and MODEL_API_KEY (hackathon rubric alias) are supported.
META_API_KEY=your_meta_model_api_key_here
MODEL_API_KEY=your_meta_model_api_key_here
META_BASE_URL=https://api.meta.ai/v1

# Meta Model Identifiers
MUSE_SPARK_MODEL=muse-spark-1.3
MUSE_WONDER_MODEL=muse-wonder-1.0
MUSE_CODE_MODEL=muse-spark-1.3
SAM31_ENDPOINT_PATH=
SPARK_TIMEOUT_SECONDS=15
WONDER_TIMEOUT_SECONDS=30
CODE_TIMEOUT_SECONDS=30
SAM31_TIMEOUT_SECONDS=10
SAM31_MAX_BATCH_SIZE=40

# --- Persistence / PostgreSQL Database ---
# PostgreSQL connection string for SQLModel (matching docker-compose.yml)
# AsyncPG driver: postgresql+asyncpg://<user>:<password>@<host>:<port>/<db>
DATABASE_URL=postgresql+asyncpg://visorqa:visorqa@localhost:5432/visorqa

# --- GitHub Integration ---
# Option A: GitHub Personal Access Token (PAT) for basic testing
GITHUB_PAT=ghp_your_personal_access_token_here

# Option B: GitHub App Bot Authentication (visorqa-agent[bot])
GITHUB_APP_ID=
GITHUB_INSTALLATION_ID=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_PRIVATE_KEY_PATH=./github-app-private-key.pem
# Inline PEM private key alternative (useful for Docker / EC2 cloud deployment)
GITHUB_PRIVATE_KEY=
GITHUB_APP_PRIVATE_KEY=

# Secret used to verify HMAC SHA-256 signatures for incoming GitHub webhook events
GITHUB_WEBHOOK_SECRET=your_github_webhook_secret_here

# --- Sandbox Execution ---
# Provider: local (default, fast Git worktree runner) | e2b | modal | stub
SANDBOX_PROVIDER=local
SANDBOX_BACKEND=local
# E2B cloud sandbox API key (https://e2b.dev). When set, scans run in ephemeral cloud micro-VMs
E2B_API_KEY=
E2B_SANDBOX_TIMEOUT_SECONDS=180
TARGET_APP_PATH=./demo-target-app
TARGET_APP_PORT=3001
SANDBOX_HMR_TIMEOUT_SECONDS=15
SANDBOX_IDLE_TIMEOUT_SECONDS=1800

# Legacy Modal configuration (when SANDBOX_PROVIDER=modal)
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=
MODAL_APP_NAME=visorqa-sandbox

# --- Server & Network Settings ---
API_HOST=0.0.0.0
API_PORT=8000
ENVIRONMENT=development
LOG_LEVEL=info

# --- Client Application URLs ---
FRONTEND_URL=https://visorqa.sayedibrahim.com
NEXT_PUBLIC_API_URL=https://api.visorqa.sayedibrahim.com
NEXT_PUBLIC_WS_URL=wss://api.visorqa.sayedibrahim.com

# --- Mathematical & Discrepancy Thresholds ---
# Occlusion threshold: Visibility Ratio = Area(M_SAM) / Area(B_DOM) < 0.85 indicates clipping
VISIBILITY_RATIO_THRESHOLD=0.85

# Collision threshold: IoU(M_i, M_j) > 0.05 indicates UI element overlap
IOU_COLLISION_THRESHOLD=0.05

# Horizontal viewport bleed threshold (mobile overflow > 2.0px)
BLEED_PX_THRESHOLD=2.0

# Self-healing maximum iterations (3-Strike Rule)
MAX_SELF_HEALING_ATTEMPTS=3
